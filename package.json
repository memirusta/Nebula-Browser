{
  "name": "nebula",
  "private": true,
  "version": "1.6.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:binary": "tauri build --no-bundle --target x86_64-pc-windows-msvc",
    "tauri:build:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:x86": "tauri build --target i686-pc-windows-msvc",
    "perf:stress": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/perf-stress.ps1",
    "perf:summary": "node scripts/perf-log-summary.mjs",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "test:regression": "node --test --experimental-strip-types tests/*.test.ts",
    "test:native-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-smoke.ps1",
    "test:release-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-smoke.ps1",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:clean-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-install-smoke.ps1",
    "test:upgrade-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/upgrade-install-smoke.ps1",
    "test:clean-sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-sandbox-smoke.ps1",
    "test:updater-remote": "node scripts/updater-remote-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/react-grid-layout": "^1.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
