{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-state-store",
  "description": "Restricts the shell state mirror to the trusted shell webviews",
  "webviews": [
    "main",
    "nebula-chrome",
    "nebula-window-*",
    "nebula-chrome-*"
  ],
  "permissions": [
    "allow-shell-state-store-commands"
  ]
}
