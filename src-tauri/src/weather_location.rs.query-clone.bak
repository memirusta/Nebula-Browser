use std::collections::{HashMap, HashSet};
use std::time::Duration;

use serde::{Deserialize, Serialize};

const OPEN_METEO_GEOCODING_URL: &str =
    "https://geocoding-api.open-meteo.com/v1/search";
const DEFAULT_OVERPASS_URL: &str =
    "https://overpass-api.de/api/interpreter";
const USER_AGENT: &str =
    "NebulaBrowser/1.5 (+https://github.com/memirusta/Nebula-Browser)";

#[derive(Clone, Debug, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct WeatherCity {
    id: String,
    name: String,
    admin_area: String,
    country_code: String,
    country: String,
    latitude: f64,
    longitude: f64,
    time_zone: String,
}

#[derive(Clone, Debug, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct WeatherSubdivision {
    id: String,
    name: String,
    city: String,
    country_code: String,
    latitude: f64,
    longitude: f64,
    time_zone: String,
    kind: String,
}

#[derive(Debug, Deserialize)]
struct OpenMeteoResponse {
    #[serde(default)]
    results: Vec<OpenMeteoResult>,
}

#[derive(Debug, Deserialize)]
struct OpenMeteoResult {
    id: i64,
    name: String,
    latitude: f64,
    longitude: f64,
    #[serde(default)]
    timezone: String,
    #[serde(default)]
    feature_code: String,
    #[serde(default)]
    country_code: String,
    #[serde(default)]
    country: String,
    #[serde(default)]
    admin1: String,
    #[serde(default)]
    admin2: String,
    #[serde(default)]
    admin3: String,
    #[serde(default)]
    admin4: String,
}

#[derive(Debug, Deserialize)]
struct OverpassResponse {
    #[serde(default)]
    elements: Vec<OverpassElement>,
}

#[derive(Debug, Deserialize)]
struct OverpassElement {
    #[serde(rename = "type")]
    element_type: String,
    id: i64,
    lat: Option<f64>,
    lon: Option<f64>,
    center: Option<OverpassCenter>,
    #[serde(default)]
    tags: HashMap<String, String>,
}

#[derive(Debug, Deserialize)]
struct OverpassCenter {
    lat: f64,
    lon: f64,
}

fn clean_language(language: &str) -> &str {
    if language.trim().eq_ignore_ascii_case("tr") {
        "tr"
    } else {
        "en"
    }
}

fn clean_country_code(country_code: &str) -> Result<String, String> {
    let code = country_code.trim().to_ascii_uppercase();

    if code.len() != 2 || !code.bytes().all(|byte| byte.is_ascii_alphabetic()) {
        return Err("country code must be a two-letter ISO code".to_string());
    }

    Ok(code)
}

fn http_client(timeout: Duration) -> Result<reqwest::Client, String> {
    reqwest::Client::builder()
        .user_agent(USER_AGENT)
        .timeout(timeout)
        .build()
        .map_err(|error| error.to_string())
}

fn first_admin_area(result: &OpenMeteoResult) -> String {
    let name = result.name.trim();

    [
        result.admin1.as_str(),
        result.admin2.as_str(),
        result.admin3.as_str(),
        result.admin4.as_str(),
    ]
    .into_iter()
    .map(str::trim)
    .find(|value| !value.is_empty() && !value.eq_ignore_ascii_case(name))
    .unwrap_or_default()
    .to_string()
}

pub async fn search_cities(
    query: String,
    country_code: String,
    language: String,
) -> Result<Vec<WeatherCity>, String> {
    let query = query.trim().to_string();

    if query.chars().count() < 2 {
        return Ok(Vec::new());
    }

    let country_code = clean_country_code(&country_code)?;
    let language = clean_language(&language).to_string();
    let client = http_client(Duration::from_secs(8))?;

    #[cfg(debug_assertions)]
    eprintln!(
        "[nebula weather] city search start query={query:?} country={country_code} language={language}"
    );

    let response = client
        .get(OPEN_METEO_GEOCODING_URL)
        .query(&[
            ("name", query),
            ("count", "8".to_string()),
            ("format", "json".to_string()),
            ("language", language),
            ("countryCode", country_code.clone()),
        ])
        .send()
        .await
        .map_err(|error| {
            #[cfg(debug_assertions)]
            eprintln!(
                "[nebula weather] city search network error query={query:?} country={country_code}: {error}"
            );

            error.to_string()
        })?;

    let status = response.status();

    #[cfg(debug_assertions)]
    eprintln!(
        "[nebula weather] city search HTTP query={query:?} country={country_code} status={status}"
    );

    if !status.is_success() {
        return Err(format!(
            "location provider returned HTTP {status}"
        ));
    }

    let payload = response
        .json::<OpenMeteoResponse>()
        .await
        .map_err(|error| {
            #[cfg(debug_assertions)]
            eprintln!(
                "[nebula weather] city search JSON error query={query:?} country={country_code}: {error}"
            );

            error.to_string()
        })?;

    #[cfg(debug_assertions)]
    {
        let names = payload
            .results
            .iter()
            .take(8)
            .map(|result| {
                format!(
                    "{} [{}] ({})",
                    result.name,
                    result.feature_code,
                    result.country_code
                )
            })
            .collect::<Vec<_>>();

        eprintln!(
            "[nebula weather] city search payload query={query:?} country={country_code} count={} results={names:?}",
            payload.results.len()
        );
    }

    let mut seen = HashSet::new();
    let mut ranked = Vec::new();

    for result in payload.results {
        let feature_rank = if result.feature_code.is_empty()
            || result.feature_code.starts_with("PPL")
        {
            0u8
        } else if result.feature_code.starts_with("ADM") {
            1u8
        } else {
            2u8
        };

        let dedupe = format!(
            "{}\0{}\0{:.4}\0{:.4}",
            result.name.to_lowercase(),
            result.country_code.to_lowercase(),
            result.latitude,
            result.longitude
        );

        if !seen.insert(dedupe) {
            continue;
        }

        let admin_area = first_admin_area(&result);

        ranked.push((
            feature_rank,
            WeatherCity {
                id: format!("open-meteo:{}", result.id),
                name: result.name,
                admin_area,
                country_code: if result.country_code.is_empty() {
                    country_code.clone()
                } else {
                    result.country_code.to_ascii_uppercase()
                },
                country: result.country,
                latitude: result.latitude,
                longitude: result.longitude,
                time_zone: if result.timezone.is_empty() {
                    "UTC".to_string()
                } else {
                    result.timezone
                },
            },
        ));
    }

    ranked.sort_by(|left, right| {
        left.0
            .cmp(&right.0)
            .then_with(|| left.1.name.cmp(&right.1.name))
    });

    let cities = ranked
        .into_iter()
        .map(|(_, city)| city)
        .take(8)
        .collect::<Vec<_>>();

    #[cfg(debug_assertions)]
    eprintln!(
        "[nebula weather] city search final query={query:?} country={country_code} count={}",
        cities.len()
    );

    Ok(cities)
}

fn element_coordinates(element: &OverpassElement) -> Option<(f64, f64)> {
    match (element.lat, element.lon) {
        (Some(lat), Some(lon)) => Some((lat, lon)),
        _ => element.center.as_ref().map(|center| (center.lat, center.lon)),
    }
}

fn haversine_km(
    lat1: f64,
    lon1: f64,
    lat2: f64,
    lon2: f64,
) -> f64 {
    const EARTH_RADIUS_KM: f64 = 6_371.0;

    let lat1 = lat1.to_radians();
    let lat2 = lat2.to_radians();
    let dlat = lat2 - lat1;
    let dlon = (lon2 - lon1).to_radians();

    let a = (dlat / 2.0).sin().powi(2)
        + lat1.cos() * lat2.cos() * (dlon / 2.0).sin().powi(2);

    2.0 * EARTH_RADIUS_KM * a.sqrt().asin()
}

fn subdivision_kind(tags: &HashMap<String, String>) -> String {
    if let Some(place) = tags.get("place") {
        return place.to_string();
    }

    if let Some(level) = tags.get("admin_level") {
        return format!("administrative · level {level}");
    }

    "district".to_string()
}

pub async fn search_subdivisions(
    city_name: String,
    country_code: String,
    latitude: f64,
    longitude: f64,
    time_zone: String,
    language: String,
) -> Result<Vec<WeatherSubdivision>, String> {
    let city_name = city_name.trim().to_string();

    if city_name.is_empty()
        || !latitude.is_finite()
        || !longitude.is_finite()
        || !(-90.0..=90.0).contains(&latitude)
        || !(-180.0..=180.0).contains(&longitude)
    {
        return Err("invalid city coordinates".to_string());
    }

    let country_code = clean_country_code(&country_code)?;
    let language = clean_language(&language);
    let endpoint = std::env::var("NEBULA_OVERPASS_URL")
        .unwrap_or_else(|_| DEFAULT_OVERPASS_URL.to_string());

    /*
     * A city can contain administrative districts as well as OSM place
     * features such as boroughs, suburbs, quarters and neighbourhoods.
     * Query only the selected city's vicinity; the country/city selection
     * itself is resolved by Open-Meteo first.
     */
    let query = format!(
        r#"[out:json][timeout:15];
(
  nwr(around:70000,{latitude},{longitude})["place"~"^(borough|suburb|quarter|neighbourhood)$"]["name"];
  rel(around:70000,{latitude},{longitude})["boundary"="administrative"]["admin_level"~"^(6|7|8|9|10|11)$"]["name"];
);
out center tags;"#
    );

    let client = http_client(Duration::from_secs(20))?;
    let response = client
        .post(endpoint)
        .form(&[("data", query)])
        .send()
        .await
        .map_err(|error| error.to_string())?;

    if !response.status().is_success() {
        return Err(format!(
            "subdivision provider returned HTTP {}",
            response.status()
        ));
    }

    let payload = response
        .json::<OverpassResponse>()
        .await
        .map_err(|error| error.to_string())?;

    let localized_name_key = format!("name:{language}");
    let mut seen = HashSet::new();
    let mut ranked = Vec::new();

    for element in payload.elements {
        let Some((lat, lon)) = element_coordinates(&element) else {
            continue;
        };

        let Some(name) = element
            .tags
            .get(&localized_name_key)
            .or_else(|| element.tags.get("name"))
            .map(|value| value.trim())
            .filter(|value| !value.is_empty())
        else {
            continue;
        };

        if name.eq_ignore_ascii_case(&city_name) {
            continue;
        }

        let distance = haversine_km(latitude, longitude, lat, lon);

        if distance > 70.0 {
            continue;
        }

        let dedupe = name.to_lowercase();

        if !seen.insert(dedupe) {
            continue;
        }

        let place_rank = match element.tags.get("place").map(String::as_str) {
            Some("borough") => 0,
            Some("suburb") => 1,
            Some("quarter") => 2,
            Some("neighbourhood") => 3,
            _ => 4,
        };

        ranked.push((
            place_rank,
            distance,
            WeatherSubdivision {
                id: format!("osm:{}:{}", element.element_type, element.id),
                name: name.to_string(),
                city: city_name.clone(),
                country_code: country_code.clone(),
                latitude: lat,
                longitude: lon,
                time_zone: if time_zone.trim().is_empty() {
                    "UTC".to_string()
                } else {
                    time_zone.clone()
                },
                kind: subdivision_kind(&element.tags),
            },
        ));
    }

    ranked.sort_by(|left, right| {
        left.0
            .cmp(&right.0)
            .then_with(|| {
                left.1
                    .partial_cmp(&right.1)
                    .unwrap_or(std::cmp::Ordering::Equal)
            })
            .then_with(|| left.2.name.cmp(&right.2.name))
    });

    Ok(ranked
        .into_iter()
        .map(|(_, _, item)| item)
        .take(80)
        .collect())
}
