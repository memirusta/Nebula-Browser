diff --git a/src/platform/tauriDownloadPopupWebview.ts b/src/platform/tauriDownloadPopupWebview.ts
new file mode 100644
index 0000000..438d1bd
--- /dev/null
+++ b/src/platform/tauriDownloadPopupWebview.ts
@@ -0,0 +1,140 @@
+import { invoke } from '@tauri-apps/api/core'
+import { PhysicalPosition, PhysicalSize } from '@tauri-apps/api/dpi'
+import { Webview, type WebviewOptions } from '@tauri-apps/api/webview'
+import { getCurrentWindow } from '@tauri-apps/api/window'
+import { tabWebviewLabel } from '../core/browserTab'
+import { isTauri } from './runtime'
+import { windowClientPhysicalSize } from './windowClientBounds'
+
+export const DOWNLOAD_POPUP_WEBVIEW_LABEL = 'nebula-download-popup'
+
+const POPUP_LOGICAL_WIDTH = 430
+let popupLogicalTop = 180
+let popupLogicalHeight = 184
+let activePopupWebview: Webview | null = null
+let resizeUnlisten: (() => void) | null = null
+let scaleUnlisten: (() => void) | null = null
+
+function popupUrl(): string {
+  return `${window.location.origin}${window.location.pathname}#download-popup`
+}
+
+function popupHeightForItems(itemCount: number): number {
+  const visibleRows = Math.max(1, Math.min(itemCount, 4))
+  return Math.min(390, 112 + visibleRows * 72)
+}
+
+async function popupPhysicalBounds(): Promise<{
+  position: PhysicalPosition
+  size: PhysicalSize
+}> {
+  const windowSize = await windowClientPhysicalSize()
+  const scaleFactor = await getCurrentWindow().scaleFactor()
+  const requestedWidth = Math.ceil(POPUP_LOGICAL_WIDTH * scaleFactor)
+  const requestedHeight = Math.ceil(popupLogicalHeight * scaleFactor)
+  const width = Math.max(1, Math.min(windowSize.width, requestedWidth))
+  const height = Math.max(1, Math.min(windowSize.height, requestedHeight))
+  const x = Math.max(0, Math.round((windowSize.width - width) / 2))
+  const requestedY = Math.round(popupLogicalTop * scaleFactor)
+  const y = Math.max(0, Math.min(windowSize.height - height, requestedY))
+
+  return {
+    position: new PhysicalPosition(x, y),
+    size: new PhysicalSize(width, height),
+  }
+}
+
+async function syncPopupBounds(webview: Webview): Promise<void> {
+  const { position, size } = await popupPhysicalBounds()
+  await webview.setPosition(position)
+  await webview.setSize(size)
+  await webview.setAutoResize(false)
+}
+
+function unbindPopupResize(): void {
+  resizeUnlisten?.()
+  resizeUnlisten = null
+  scaleUnlisten?.()
+  scaleUnlisten = null
+}
+
+async function bindPopupResize(webview: Webview): Promise<void> {
+  unbindPopupResize()
+  const appWindow = getCurrentWindow()
+  const sync = () => {
+    void syncPopupBounds(webview)
+  }
+  resizeUnlisten = await appWindow.onResized(sync)
+  scaleUnlisten = await appWindow.onScaleChanged(sync)
+}
+
+async function waitForWebviewCreated(webview: Webview): Promise<void> {
+  await new Promise<void>((resolve, reject) => {
+    const timeout = setTimeout(() => reject(new Error('download popup create timeout')), 10_000)
+    const done = () => clearTimeout(timeout)
+
+    webview.once('tauri://created', () => {
+      done()
+      resolve()
+    })
+    webview.once('tauri://error', (event) => {
+      done()
+      reject(event)
+    })
+  })
+}
+
+async function restack(activeTabId: string | null): Promise<void> {
+  await invoke('webview_raise_chrome', {
+    activeTabLabel: activeTabId ? tabWebviewLabel(activeTabId) : null,
+  })
+}
+
+export async function showDownloadPopupWebview(
+  activeTabId: string | null,
+  logicalTop: number,
+  itemCount: number,
+): Promise<void> {
+  if (!isTauri) return
+
+  popupLogicalTop = Math.max(0, logicalTop)
+  popupLogicalHeight = popupHeightForItems(itemCount)
+
+  const appWindow = getCurrentWindow()
+  let webview = activePopupWebview ?? (await Webview.getByLabel(DOWNLOAD_POPUP_WEBVIEW_LABEL))
+  const bounds = await popupPhysicalBounds()
+
+  if (!webview) {
+    const options: WebviewOptions = {
+      url: popupUrl(),
+      x: bounds.position.x,
+      y: bounds.position.y,
+      width: bounds.size.width,
+      height: bounds.size.height,
+      transparent: true,
+      focus: false,
+    }
+
+    webview = new Webview(appWindow, DOWNLOAD_POPUP_WEBVIEW_LABEL, options)
+    await waitForWebviewCreated(webview)
+    await invoke('webview_setup_branding', { label: DOWNLOAD_POPUP_WEBVIEW_LABEL })
+  }
+
+  activePopupWebview = webview
+  await syncPopupBounds(webview)
+  await bindPopupResize(webview)
+  await webview.show()
+  await restack(activeTabId)
+}
+
+export async function hideDownloadPopupWebview(activeTabId: string | null): Promise<void> {
+  if (!isTauri) return
+
+  unbindPopupResize()
+  const webview = activePopupWebview ?? (await Webview.getByLabel(DOWNLOAD_POPUP_WEBVIEW_LABEL))
+  if (webview) {
+    activePopupWebview = webview
+    await webview.hide()
+  }
+  await restack(activeTabId)
+}
