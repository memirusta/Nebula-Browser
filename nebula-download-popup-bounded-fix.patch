diff --git a/src/core/downloadPopupBridge.ts b/src/core/downloadPopupBridge.ts
new file mode 100644
index 0000000..c8350f2
--- /dev/null
+++ b/src/core/downloadPopupBridge.ts
@@ -0,0 +1,44 @@
+import { emit, listen } from '@tauri-apps/api/event'
+import type { DownloadItem } from './download'
+import { isTauri } from '../platform/runtime'
+
+export type DownloadPopupCommand =
+  | { type: 'ready' }
+  | { type: 'close' }
+  | { type: 'remove'; id: string }
+  | { type: 'clear-finished' }
+
+const DOWNLOAD_POPUP_STATE_EVENT = 'nebula-download-popup-state'
+const DOWNLOAD_POPUP_COMMAND_EVENT = 'nebula-download-popup-command'
+
+export function isDownloadPopupShell(): boolean {
+  return window.location.hash === '#download-popup'
+}
+
+export async function emitDownloadPopupState(items: DownloadItem[]): Promise<void> {
+  if (!isTauri) return
+  await emit(DOWNLOAD_POPUP_STATE_EVENT, { items })
+}
+
+export function listenDownloadPopupState(
+  handler: (items: DownloadItem[]) => void,
+): Promise<() => void> {
+  if (!isTauri) return Promise.resolve(() => {})
+  return listen<{ items: DownloadItem[] }>(DOWNLOAD_POPUP_STATE_EVENT, (event) => {
+    handler(event.payload.items)
+  })
+}
+
+export async function emitDownloadPopupCommand(command: DownloadPopupCommand): Promise<void> {
+  if (!isTauri) return
+  await emit(DOWNLOAD_POPUP_COMMAND_EVENT, command)
+}
+
+export function listenDownloadPopupCommands(
+  handler: (command: DownloadPopupCommand) => void,
+): Promise<() => void> {
+  if (!isTauri) return Promise.resolve(() => {})
+  return listen<DownloadPopupCommand>(DOWNLOAD_POPUP_COMMAND_EVENT, (event) => {
+    handler(event.payload)
+  })
+}
