@@ -0,0 +1,50 @@
+import { useEffect, useState } from 'react'
+import { DownloadManager } from './components/DownloadManager/DownloadManager'
+import { controlDownload, type DownloadItem } from './core/download'
+import {
+  emitDownloadPopupCommand,
+  listenDownloadPopupState,
+} from './core/downloadPopupBridge'
+import './styles/global.css'
+
+export function DownloadPopupApp() {
+  const [items, setItems] = useState<DownloadItem[]>([])
+
+  useEffect(() => {
+    let disposed = false
+    let unlisten: (() => void) | undefined
+
+    void listenDownloadPopupState((next) => {
+      if (!disposed) setItems(next)
+    }).then((dispose) => {
+      if (disposed) {
+        dispose()
+        return
+      }
+      unlisten = dispose
+      void emitDownloadPopupCommand({ type: 'ready' })
+    })
+
+    return () => {
+      disposed = true
+      unlisten?.()
+    }
+  }, [])
+
+  return (
+    <DownloadManager
+      items={items}
+      variant="popup"
+      onAction={controlDownload}
+      onRemove={(id) => {
+        void emitDownloadPopupCommand({ type: 'remove', id })
+      }}
+      onClearFinished={() => {
+        void emitDownloadPopupCommand({ type: 'clear-finished' })
+      }}
+      onClose={() => {
+        void emitDownloadPopupCommand({ type: 'close' })
+      }}
+    />
+  )
+}
